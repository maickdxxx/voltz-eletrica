    {"id":"hero-whatsapp","type":"whatsapp_click","label":"WhatsApp do hero","targetPath":"global.brand.whatsapp","messagePath":"global.contact.whatsappMessage","required":true},
    {"id":"phone-click","type":"tel_click","label":"Clique no telefone","targetPath":"global.brand.phone"},
    {"id":"contact-form","type":"form_submit","label":"Formulário de orçamento","required":true},
    {"id":"hero-services","type":"cta_click","label":"Botão de serviços do hero","targetPath":"pages.home.hero.secondaryCta.href"}
  ],
  "images": [
    {"id":"brand-logo","label":"Logo","srcPath":"global.brand.logoUrl","altPath":"global.brand.logoAlt","required":true},
    {"id":"hero-home","label":"Imagem principal","srcPath":"pages.home.hero.imageUrl","altPath":"pages.home.hero.imageAlt","required":true},
    {"id":"home-about","label":"Imagem da seção sobre","srcPath":"pages.home.about.imageUrl","altPath":"pages.home.about.imageAlt"},
    {"id":"about-hero","label":"Imagem da página sobre","srcPath":"pages.about.hero.imageUrl","altPath":"pages.about.hero.imageAlt"}
