  "forms": [{"id":"contact","label":"Formulário de orçamento","schemaPath":"pages.contact.form","eventLabel":"Orçamento via WhatsApp"}],
  "theme": {"colors":{"primary":"global.theme.colors.primary","secondary":"global.theme.colors.secondary","accent":"global.theme.colors.accent","background":"global.theme.colors.background","surface":"global.theme.colors.surface","text":"global.theme.colors.text","muted":"global.theme.colors.muted","dark":"global.theme.colors.dark","whatsapp":"global.theme.colors.whatsapp"}},
  "collections": {
    "services": {"enabled":true,"path":"collections.services","requiredFields":["id","slug","title","description","active"]},
    "testimonials": {"enabled":true,"path":"collections.testimonials","requiredFields":["id","name","quote","active"]},
    "faq": {"enabled":true,"path":"collections.faq","requiredFields":["id","question","answer","active"]},
    "serviceAreas": {"enabled":true,"path":"collections.serviceAreas","requiredFields":["id","name","active"]}
