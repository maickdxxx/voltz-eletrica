  "pages": [
    {"pageId":"home","label":"Início","path":"/","schemaPath":"pages.home","seoPath":"pages.home.seo","showInNav":true},
    {"pageId":"about","label":"Sobre","path":"/sobre","schemaPath":"pages.about","seoPath":"pages.about.seo","showInNav":true},
    {"pageId":"services","label":"Serviços","path":"/servicos","schemaPath":"pages.services","seoPath":"pages.services.seo","showInNav":true},
